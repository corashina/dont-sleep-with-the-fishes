{
  "name": "dont-sleep-with-the-fishes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run lint && tsc --noEmit && vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "playtest:serve": "vite-node scripts/serve-browser-playtest.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "balance:survival": "vite-node scripts/simulate-survival-balance.ts",
    "models:fetch:items": "pwsh -NoProfile -File scripts/fetch-item-models.ps1",
    "models:fetch:ship": "pwsh -NoProfile -File scripts/fetch-ship-furniture.ps1",
    "models:fetch:fishing": "pwsh -NoProfile -File scripts/fetch-fishing-models.ps1",
    "models:fetch:events": "pwsh -NoProfile -File scripts/fetch-event-models.ps1",
    "models:fetch:menu": "pwsh -NoProfile -File scripts/fetch-menu-models.ps1",
    "models:fetch": "bun run models:fetch:items && bun run models:fetch:ship && bun run models:fetch:fishing && bun run models:fetch:events && bun run models:fetch:menu",
    "models:check:items": "node scripts/check-item-models.mjs",
    "models:check:ship": "node scripts/check-ship-furniture.mjs",
    "models:check:fishing": "node scripts/check-fishing-models.mjs",
    "models:check:events": "node scripts/check-event-models.mjs",
    "models:check:menu": "node scripts/check-menu-models.mjs",
    "textures:fetch:lifeboat": "pwsh -NoProfile -File scripts/fetch-lifeboat-textures.ps1",
    "textures:check:lifeboat": "node scripts/check-lifeboat-textures.mjs",
    "textures:fetch:ship": "pwsh -NoProfile -File scripts/fetch-ship-textures.ps1",
    "textures:check:ship": "node scripts/check-ship-textures.mjs",
    "models:check": "bun run models:check:items && bun run models:check:ship && bun run models:check:fishing && bun run models:check:events && bun run models:check:menu && bun run textures:check:lifeboat && bun run textures:check:ship",
    "audio:fetch": "node scripts/fetch-audio-assets.mjs",
    "thumbnails:generate": "node scripts/generate-item-thumbnails.mjs",
    "thumbnails:check": "node scripts/check-item-thumbnails.mjs",
    "powershell:check": "pwsh -NoProfile -File scripts/check-powershell-portability.ps1"
  },
  "dependencies": {
    "@dimforge/rapier3d-deterministic-compat": "0.19.3",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.4.1",
    "@gltf-transform/core": "^4.4.1",
    "@gltf-transform/extensions": "^4.4.1",
    "@gltf-transform/functions": "^4.4.1",
    "@types/three": "^0.180.0",
    "eslint": "^10.9.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
